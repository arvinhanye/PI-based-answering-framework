{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "source": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "originalPath": {
          "type": "string"
        },
        "pageCount": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "paragraphCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "processing": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "page": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "status": {
                "type": "string",
                "enum": [
                  "converted",
                  "failed"
                ]
              },
              "candidateIds": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "unrecognizedRegions": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "outputHash": {
                "type": "string"
              },
              "error": {
                "type": "string"
              }
            },
            "required": [
              "page",
              "status",
              "candidateIds",
              "unrecognizedRegions",
              "outputHash"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "id",
        "name",
        "sha256"
      ],
      "additionalProperties": false
    },
    "questions": {
      "maxItems": 100000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sourceKey": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "single",
              "multiple",
              "truefalse",
              "fill",
              "short"
            ]
          },
          "stem": {
            "type": "string",
            "minLength": 1
          },
          "options": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "text": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "text"
              ],
              "additionalProperties": false
            }
          },
          "answer": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "rawAnswer": {
            "type": "string"
          },
          "explanation": {
            "type": "string"
          },
          "topics": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "ready",
              "needs_review"
            ]
          },
          "basisStatus": {
            "type": "string",
            "enum": [
              "source_only",
              "verified",
              "insufficient",
              "disputed"
            ]
          },
          "issues": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "locations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "page": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "paragraph": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "bbox": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    }
                  ]
                }
              },
              "additionalProperties": false
            }
          },
          "assets": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "mime": {
                  "type": "string",
                  "minLength": 1
                },
                "role": {
                  "type": "string",
                  "enum": [
                    "question",
                    "source"
                  ]
                },
                "caption": {
                  "type": "string"
                }
              },
              "required": [
                "path",
                "sha256",
                "mime",
                "role"
              ],
              "additionalProperties": false
            }
          },
          "equivalentAnswers": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "required": [
          "sourceKey",
          "kind",
          "stem",
          "options",
          "answer",
          "rawAnswer",
          "explanation",
          "topics",
          "status",
          "basisStatus",
          "issues",
          "locations",
          "assets"
        ],
        "additionalProperties": false
      }
    },
    "report": {
      "type": "object",
      "properties": {
        "candidateCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "ready": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "needsReview": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "processedPages": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "processedParagraphs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "gaps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "candidateCount",
        "ready",
        "needsReview",
        "gaps"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "source",
    "questions",
    "report"
  ],
  "additionalProperties": false
}
